# Post-Processing Overhaul

option.BLOOM_STRENGTH=Bloom Strength
value.BLOOM_STRENGTH.0.01=0.01 (Minimal)
value.BLOOM_STRENGTH.0.03=0.03 (Soft)
value.BLOOM_STRENGTH.0.06=0.06 (Bright)
value.BLOOM_STRENGTH.0.08=0.08 (Dreamy)
value.BLOOM_STRENGTH.0.10=0.10 (Ethereal)
value.BLOOM_STRENGTH.0.12=0.12 (Intense)
value.BLOOM_STRENGTH.0.15=0.15 (Overloaded)
value.BLOOM_STRENGTH.0.18=0.18 (Extreme)
value.BLOOM_STRENGTH.0.22=0.22 (Nebula)
value.BLOOM_STRENGTH.0.26=0.26 (Supernova)
value.BLOOM_STRENGTH.0.30=0.30 (Hypernova)
option.BLOOM_STRENGTH.comment=Controls the brightness and intensity of the soft-knee bloom glow around light sources.

option.AUTO_EXPOSURE=Auto Exposure
option.AUTO_EXPOSURE.comment=Enables dynamic camera-like eye adaptation, automatically adjusting exposure when transitioning between dark caves and bright skylines.
option.EXPOSURE=Exposure Bias
option.EXPOSURE.comment=Manual exposure multiplier. Acts as a base brightness level for the entire scene.
option.AUTO_EXPOSURE_TARGET=Exposure Target
option.AUTO_EXPOSURE_TARGET.comment=The brightness level the auto-exposure tries to achieve. Higher values result in a brighter image.
option.AUTO_EXPOSURE_SPEED=Exposure Speed
option.AUTO_EXPOSURE_SPEED.comment=How fast the eye adapts to changes in light.
option.AUTO_EXPOSURE_CENTER_WEIGHT=Center Weighting
option.AUTO_EXPOSURE_CENTER_WEIGHT.comment=How much the center of the screen affects the auto-exposure compared to the edges. Higher values prioritize the player's focus area.
option.AUTO_EXPOSURE_MIN=Min Exposure
option.AUTO_EXPOSURE_MIN.comment=The lowest possible exposure level (prevents the image from getting too dark in extremely bright areas).
option.AUTO_EXPOSURE_MAX=Max Exposure
option.AUTO_EXPOSURE_MAX.comment=The highest possible exposure level (prevents the image from getting too bright in extremely dark areas).

option.TONEMAP_OPERATOR=Tonemapper
value.TONEMAP_OPERATOR.0=ACES Filmic
value.TONEMAP_OPERATOR.1=Timothy Lottes
value.TONEMAP_OPERATOR.2=Reinhard-Jodie
value.TONEMAP_OPERATOR.3=Uncharted 2
value.TONEMAP_OPERATOR.4=Original Serie
option.TONEMAP_OPERATOR.comment=Choose the filmic curve algorithm for mapping HDR colors down to the LDR display space.

option.COLOR_CONTRAST=Contrast
option.COLOR_CONTRAST.comment=Adjusts the dynamic luminance separation of the image. Higher values increase depth and dramatic punch.

option.COLOR_SATURATION=Saturation
option.COLOR_SATURATION.comment=Controls the vibrant saturation levels of the scene.

option.COLOR_TEMP=Color Temperature
value.COLOR_TEMP.-0.5=-0.5 (Icy Cool)
value.COLOR_TEMP.-0.4=-0.4
value.COLOR_TEMP.-0.3=-0.3
value.COLOR_TEMP.-0.2=-0.2 (Cool)
value.COLOR_TEMP.-0.1=-0.1
value.COLOR_TEMP.0.0=0.0 (Neutral)
value.COLOR_TEMP.0.1=0.1
value.COLOR_TEMP.0.2=0.2 (Warm)
value.COLOR_TEMP.0.3=0.3
value.COLOR_TEMP.0.4=0.4
value.COLOR_TEMP.0.5=0.5 (Warm Amber)
option.COLOR_TEMP.comment=Shifts color temperature. Negative values introduce cooler blue tones, positive values add warmer golden-hour amber tones.

option.VIGNETTE=Cinematic Vignette
option.VIGNETTE.comment=Applies a subtle darkening around the edges of the viewport to create a professional photographic lens effect.

option.GI_DEBUG_VIEW=GI Debug View
option.GI_DEBUG_VIEW.comment=Outputs the raw/denoised GI buffer directly to the screen to visualize the indirect light reaching the surfaces.


option.VOXEL_GRID_SIZE=Voxel Grid Size
option.VOXEL_GRID_SIZE.comment=Changes the bounds of the voxel path tracing volume. Higher values trace further but reduce performance.
value.VOXEL_GRID_SIZE.64=64 (Small)
value.VOXEL_GRID_SIZE.128=128 (Normal)
value.VOXEL_GRID_SIZE.256=256 (Large)

# Atmosphere & Sky Settings
screen.Atmosphere=Atmosphere & Sky
screen.Atmosphere.comment=Configure physical atmosphere density, scattering, and illuminance coefficients.

option.SKY_LUT_STEPS=Sky Integration Steps
option.SKY_LUT_STEPS.comment=Number of uniform raymarching steps for the Sky-View precomputation. Lower is faster; higher yields smoother horizons (reduces elevation banding).

option.SUN_ILLUMINANCE=Sun Illuminance
option.SUN_ILLUMINANCE.comment=Physical intensity of the sun light term inside the atmospheric scattering solver.

option.MOON_ILLUMINANCE=Moon Illuminance
option.MOON_ILLUMINANCE.comment=Physical intensity of the moon light term inside the atmospheric scattering solver.

option.MIE_G=Mie Asymmetry (G)
option.MIE_G.comment=Governs forward-scattering sharpness. Higher values concentrate Mie glow closer to the sun disk, creating a sharper, brighter solar halo.

option.RAYLEIGH_SCATTER_R=Rayleigh Scatter (Red)
option.RAYLEIGH_SCATTER_R.comment=Scattering coefficient for red light wavelengths. Controls the warm amber/sunset hues of the atmosphere.

option.RAYLEIGH_SCATTER_G=Rayleigh Scatter (Green)
option.RAYLEIGH_SCATTER_G.comment=Scattering coefficient for green light wavelengths.

option.RAYLEIGH_SCATTER_B=Rayleigh Scatter (Blue)
option.RAYLEIGH_SCATTER_B.comment=Scattering coefficient for blue light wavelengths. Controls the deep blue daytime zenith of the sky.

option.MIE_SCATTER_R=Mie Scatter (Red)
option.MIE_SCATTER_R.comment=Aerosol/dust scattering coefficient for red light. Governs sunset horizon haze coloration.

option.MIE_SCATTER_G=Mie Scatter (Green)
option.MIE_SCATTER_G.comment=Aerosol/dust scattering coefficient for green light.

option.MIE_SCATTER_B=Mie Scatter (Blue)
option.MIE_SCATTER_B.comment=Aerosol/dust scattering coefficient for blue light.

option.OZONE_PEAK=Ozone Peak Concentration
option.OZONE_PEAK.comment=Peak ozone concentration level in the stratosphere. Governs the purple/blue transition bands during twilight.

# Volumetric Light
screen.Volumetric-Light=Volumetric Light
screen.Volumetric-Light.comment=Configure dithered raymarching steps, intensity, and time-of-day multipliers for volumetric light and god rays.

option.VOLUMETRIC_LIGHT=Volumetric Light
option.VOLUMETRIC_LIGHT.comment=Enables shadowmap-aware volumetric atmospheric lighting (crepuscular god rays).

option.VL_STEPS=Volumetric Steps
option.VL_STEPS.comment=Controls the number of raymarching steps. Higher values yield smoother and sharper rays but reduce performance.

option.VL_INTENSITY=Volumetric Intensity
option.VL_INTENSITY.comment=Base intensity and brightness multiplier of volumetric god rays.

option.VL_NOON_STRENGTH=Noon VL Multiplier
option.VL_NOON_STRENGTH.comment=Multiplier for volumetric light strength when the sun is high in the sky (midday).

option.VL_SUN_RISE_SET_STRENGTH=Sunrise/Sunset VL Multiplier
option.VL_SUN_RISE_SET_STRENGTH.comment=Multiplier for volumetric light strength during sunrise and sunset (golden hour).

option.VL_NIGHT_STRENGTH=Night VL Multiplier
option.VL_NIGHT_STRENGTH.comment=Multiplier for volumetric light strength during the night (using moonlight crepuscular rays).
